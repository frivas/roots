# Never prefix secrets (API keys, tokens, service-role keys) with VITE_.
# Vite inlines any VITE_* value into the public JS bundle.
# Clerk publishable keys are public by design.

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Backend API
VITE_BACKEND_URL=http://localhost:3000
