{
  "ignore": ["eslint.config.js"],
  "ignoreBinaries": ["playwright", "supabase"],
  "ignoreDependencies": ["react", "react-dom"],
  "workspaces": {
    "frontend": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/test/**"],
      "ignoreDependencies": [
        "@eslint/js",
        "eslint-plugin-react-hooks",
        "eslint-plugin-react-refresh",
        "globals",
        "typescript-eslint"
      ]
    },
    "backend": {
      "entry": ["src/index.ts", "api/serverless.ts", "api/health.ts"],
      "project": ["src/**/*.ts", "api/**/*.ts"],
      "ignoreDependencies": [
        "tsx",
        "globals"
      ]
    }
  }
}
