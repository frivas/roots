{
  "name": "roots",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/frivas/roots.git"
  },
  "bugs": {
    "url": "https://github.com/frivas/roots/issues"
  },
  "homepage": "https://github.com/frivas/roots#readme",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "cd frontend && npm run build",
    "build:frontend:release": "cd frontend && npm run build:release",
    "build:backend": "cd backend && npm run build",
    "build": "npm run build:frontend && npm run build:backend",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "typecheck:frontend": "npm --workspace frontend run typecheck",
    "typecheck:backend": "npm --workspace backend run typecheck",
    "dead-code": "knip",
    "license-check": "node scripts/check-production-licenses.mjs",
    "audit:frontend": "node scripts/check-npm-audit.mjs --workspace frontend",
    "audit:backend": "node scripts/check-npm-audit.mjs --workspace backend",
    "audit:production": "npm run audit:frontend && npm run audit:backend",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:performance-slo": "node scripts/check-performance-slo.mjs",
    "check:performance-slo:config": "node scripts/check-performance-slo.mjs --config-only",
    "validate:release-config": "node scripts/validate-release-config.mjs",
    "validate:ci-config": "node scripts/validate-ci-config.mjs",
    "lint": "concurrently \"cd frontend && npm run lint\" \"cd backend && npm run lint\"",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm run test",
    "test:backend": "cd backend && npm run test",
    "test:e2e": "cd frontend && npm run test:e2e",
    "test:e2e:auth": "npm --workspace frontend run test:e2e:auth",
    "install:e2e-browsers": "npm exec --workspace frontend -- playwright install --with-deps chromium webkit",
    "test:serverless": "npm --workspace backend run test:serverless",
    "test:contracts": "npm --workspace backend run test:contracts",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local",
    "test:rls:local": "supabase test db --local supabase/tests/clerk_rls.test.sql",
    "test:coverage": "cd frontend && npm run test:coverage && cd ../backend && npm run test:coverage",
    "test:tooling": "node --test scripts/*.test.mjs",
    "report:portfolio-coverage": "bash scripts/report-portfolio-coverage.sh",
    "check-localization": "node scripts/check-localization.js",
    "pre-commit": "npm run check-localization && npm run lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "knip": "6.29.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "supportedArchitectures": {
    "os": [
      "darwin",
      "linux",
      "win32"
    ],
    "cpu": [
      "x64",
      "arm64"
    ]
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-x64": "^4.63.1"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "undici": ">=7.29.0 <8",
    "esbuild": "0.28.1",
    "fast-xml-parser": "5.5.9",
    "next": "16.2.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "diff": "8.0.4",
    "yaml": "2.9.0",
    "tmp": "0.2.5",
    "jsdom": {
      "undici": "7.29.0"
    },
    "@vercel/node": {
      "path-to-regexp": "^6.3.0"
    },
    "@vercel/python-analysis": {
      "minimatch": "^10.2.3",
      "smol-toml": "^1.6.1",
      "js-yaml": ">=4.2.0"
    },
    "@vercel/static-config": {
      "ajv": "^8.18.0"
    },
    "@clerk/clerk-react": {
      "@clerk/shared": "3.47.7"
    },
    "@lingo.dev/_react": {
      "next": "15.5.15",
      "lodash": "4.18.1"
    },
    "lingo.dev": {
      "@modelcontextprotocol/sdk": "1.29.0",
      "diff": "8.0.4",
      "yaml": "2.9.0"
    },
    "tar": ">=7.5.22",
    "postcss": ">=8.5.23",
    "shell-quote": ">=1.10.0",
    "find-my-way": ">=9.7.0",
    "brace-expansion": ">=5.0.9",
    "@ts-morph/common": {
      "brace-expansion": "1.1.18"
    }
  }
}
