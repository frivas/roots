{
  "name": "roots-backend",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/frivas/roots.git"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run start",
    "build": "node ../scripts/clean-backend-dist.mjs && tsc --project tsconfig.build.json",
    "build:debug": "node ../scripts/clean-backend-dist.mjs && tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "vercel-build": "npm run build",
    "lint": "eslint src/ --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:serverless": "vitest run src/serverless-adapter.test.ts",
    "test:contracts": "RUN_SUPABASE_CONTRACT_TESTS=1 vitest run src/integration/clerk-supabase.contract.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "dependencies": {
    "@clerk/fastify": "^3.1.66",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/functions": "3.8.0",
    "fastify": "^5.11.2",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@vercel/node": "^5.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
